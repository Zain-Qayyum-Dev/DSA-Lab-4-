#include <iostream>
#include <chrono>
#include <cstdlib>
#include <iomanip>
using namespace std;

struct Node {
    int data;
    Node* next;
};

int main() {
    int sizes[] = {100, 1000, 10000, 100000};

    cout << fixed << setprecision(5);

    for (int n : sizes) {

        Node* head = nullptr;
        Node* temp = nullptr;

        for (int i = 0; i < n; i++) {
            Node* newNode = new Node{};
            newNode->data = rand();
            newNode->next = nullptr;

            if (head == nullptr)
                head = newNode;
            else
                temp->next = newNode;

            temp = newNode;
        }

        cout << "\nList size: " << n << endl;

        temp = head;

        auto start = chrono::high_resolution_clock::now();

        temp = temp->next;

        auto end = chrono::high_resolution_clock::now();

        double timeTaken =
            chrono::duration<double, milli>(end - start).count();

        cout << "Position: 1"
             << " | Nodes examined: 1"
             << " | Time: " << timeTaken << " ms" << endl;

        temp = head;
        int examined = 0;

        start = chrono::high_resolution_clock::now();

        while (examined < n / 2) {
            temp = temp->next;
            examined++;
        }

        end = chrono::high_resolution_clock::now();

        timeTaken =
            chrono::duration<double, milli>(end - start).count();

        cout << "Position: " << n / 2
             << " | Nodes examined: " << examined
             << " | Time: " << timeTaken << " ms" << endl;

        temp = head;
        examined = 0;

        start = chrono::high_resolution_clock::now();

        while (examined < n) {
            if (examined == n - 1)
                break;

            temp = temp->next;
            examined++;
        }

        end = chrono::high_resolution_clock::now();

        timeTaken =
            chrono::duration<double, milli>(end - start).count();

        cout << "Position: " << n
             << " | Nodes examined: " << n
             << " | Time: " << timeTaken << " ms" << endl;
    }

    return 0;
}
